        </mxCell>
        <mxCell id="px4" value="PX4 SITL&#10;Xử lý HEARTBEAT hoặc lệnh" style="shape=rectangle;rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#E8EDF5;strokeColor=#58718E;strokeWidth=2;fontFamily=Arial;fontSize=22;fontColor=#21354C;fontStyle=1;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="1285" width="460" height="85" as="geometry" />
        </mxCell>
        <mxCell id="ack" value="ACK và telemetry trạng thái&#10;Quay về qua luồng telemetry (trang 01)" style="shape=rectangle;rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#E8F5F1;strokeColor=#4A9680;strokeWidth=2;fontFamily=Arial;fontSize=22;fontColor=#21354C;fontStyle=1;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1420" width="500" height="105" as="geometry" />
        </mxCell>
        <mxCell id="role-note" value="VAI TRÒ KẾT NỐI&#10;TCP 5760: client quan sát.&#10;TCP 5761: tối đa 1 client điều khiển.&#10;Kết nối điều khiển thứ hai bị từ chối." style="shape=rectangle;rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#F7F8FA;strokeColor=#CCD4DE;strokeWidth=2;fontFamily=Arial;fontSize=19;fontColor=#21354C;fontStyle=0;align=center;verticalAlign=middle;spacing=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="220" width="380" height="165" as="geometry" />
        </mxCell>
        <mxCell id="allow" value="BẢN TIN UPLINK ĐƯỢC PHÉP&#10;HEARTBEAT của GCS.&#10;COMMAND_LONG:&#10;ARM, TAKEOFF, LAND." style="shape=rectangle;rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#F7F8FA;strokeColor=#CCD4DE;strokeWidth=2;fontFamily=Arial;fontSize=19;fontColor=#21354C;fontStyle=0;align=center;verticalAlign=middle;spacing=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="640" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tcp-note" value="QUY TẮC TCP&#10;Thiếu byte: giữ lại và chờ.&#10;Một lần recv có thể chứa&#10;một phần hoặc nhiều khung.&#10;Bộ đệm riêng mỗi session;&#10;giới hạn đề xuất: 64 KiB." style="shape=rectangle;rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#F7F8FA;strokeColor=#CCD4DE;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#21354C;fontStyle=0;align=center;verticalAlign=middle;spacing=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1015" y="645" width="255" height="220" as="geometry" />
        </mxCell>
        <mxCell id="manager" value="COMMAND MANAGER TẠI CLIENT&#10;&#10;Chỉ 1 yêu cầu đang chờ.&#10;Ghép đúng ACK với yêu cầu.&#10;&#10;Đề xuất chờ ACK: 1 giây.&#10;Tối đa 3 lần gửi tổng cộng.&#10;ACK đang thực hiện có&#10;chính sách chờ riêng.&#10;&#10;ACK chấp nhận chưa chứng minh&#10;hành động đã hoàn tất; cần&#10;kiểm tra telemetry / trạng thái." style="shape=rectangle;rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#F7F8FA;strokeColor=#CCD4DE;strokeWidth=2;fontFamily=Arial;fontSize=19;fontColor=#21354C;fontStyle=0;align=center;verticalAlign=middle;spacing=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="1020" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="LOG: ghi session, mã lệnh, nguồn / đích, lần thử, ACK và kết quả.&#10;Mất kết nối khi chờ ACK: kết thúc cục bộ là chưa xác định; không tự gửi lại sau reconnect." style="shape=rectangle;rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#F7F8FA;strokeColor=#CCD4DE;strokeWidth=2;fontFamily=Arial;fontSize=19;fontColor=#21354C;fontStyle=0;align=center;verticalAlign=middle;spacing=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="1600" width="1205" height="85" as="geometry" />
        </mxCell>
